# Admin Authentication
# Generate a strong password: openssl rand -base64 32
ADMIN_PASSWORD="your-secure-password-here"

# Session Secret (for JWT signing)
# Generate: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# Upstash Redis: connect it to the Vercel project for drafts, published content,
# version history, login rate limits, and likes. This app reads these KV_ names.
# If the integration provides UPSTASH_REDIS_REST_URL/TOKEN instead, add their
# values under the matching KV_ names in Vercel project settings.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Vercel Blob is optional and used only for image uploads from the editor.
# Connect a public Blob store to the project. New Vercel stores can authenticate
# automatically with OIDC; legacy token-based stores can use this variable.
# Without Blob, image URLs entered in the editor still work.
# BLOB_READ_WRITE_TOKEN=""
