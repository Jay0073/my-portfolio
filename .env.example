# Admin Authentication
# Generate a strong password: openssl rand -base64 32
ADMIN_PASSWORD="your-secure-password-here"

# Session Secret (for JWT signing)
# Generate: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# Vercel KV (auto-provided when you add Vercel KV integration)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# KV_REST_API_READ_ONLY_TOKEN=""

# Vercel Blob (Storage integration → copy the token here)
# Used by /api/admin/upload for image uploads. Without it, uploads fail but the editor still works with URLs.
# BLOB_READ_WRITE_TOKEN=""